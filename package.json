{
  "name": "nexaflow-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:framework-capture": "vitest run tests/generated-token-capture-boundary.test.ts tests/token-lifecycle-header-boundary.test.ts tests/phase4-identity-token-intent.test.ts tests/phase4-invitation-boundary.test.ts && npm run build && playwright test --config=playwright.framework-capture.config.ts",
    "test:integration": "RUN_DB_INTEGRATION=1 vitest run tests/*.integration.test.ts --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:health": "tsx -e \"import {createDb} from './src/server/db/client'; import {databaseHealth} from './src/server/db/health'; const {pool}=createDb(); databaseHealth(pool).then(console.log).finally(()=>pool.end())\"",
    "email:worker": "tsx src/server/email/worker.ts",
    "email:worker:continuous": "tsx src/server/email/worker.ts --continuous",
    "local:up": "docker compose -f docker-compose.local.yml up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:reset": "docker compose -f docker-compose.local.yml down -v && docker compose -f docker-compose.local.yml up -d --wait"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.0.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.30.0",
    "next": "^16.3.1",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
