# Local development placeholders only. Do not put production or vendor credentials here.
NODE_ENV=development
DATABASE_URL=postgres://nexaflow:nexaflow@127.0.0.1:54329/nexaflow
SESSION_COOKIE_NAME=nexaflow_session
SESSION_SECRET=local-only-placeholder-change-before-production
EMAIL_PROVIDER=smtp-local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# UAT/production-only protected keys. Keep values out of tracked files:
# RESEND_API_KEY=
# EMAIL_FROM="NexaFlow accounts <accounts@mail.nexaflowsystems.com>"
# EMAIL_REPLY_TO=
APP_ORIGIN=http://127.0.0.1:3000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=24
SESSION_TOUCH_INTERVAL_SECONDS=60
TRUSTED_PROXY_ENABLED=false
OIDC_FIXTURE_SECRET=local-oidc-fixture-secret-change-before-production
OIDC_MODE=fixture
OIDC_REDIRECT_URIS=http://127.0.0.1:3000/api/auth/oidc/callback,http://127.0.0.1:3000/api/auth/recent/oidc/callback
INVITATION_TTL_HOURS=168
RECENT_AUTH_MINUTES=10
# TRUSTED_PROXY_SECRET is required only when a configured reverse proxy injects authenticated forwarding headers.
